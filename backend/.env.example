# Copy this file to .env (already gitignored) and fill in real values.
# .env is read automatically by config.py on startup — no need to `export`
# these in your shell every time.
#
# Everything below is OPTIONAL and only matters for a centrally-hosted
# deployment (MT_REQUIRE_AUTH=true). The normal local/self-hosted backend
# needs none of this — just run `python main.py` with no .env at all.

# Gates /translate, /translate/batch, /suggest-instructions, and /test-key
# behind a registered account (see backend/auth.py).
MT_REQUIRE_AUTH=false

# Real Postgres connection string for the account store (core/accounts.py).
# `docker compose up -d` (backend/docker-compose.yml) starts a local one
# matching these exact credentials.
MT_DATABASE_URL=postgresql+psycopg2://manga_translator:manga_translator@localhost:5432/manga_translator

# OAuth client ID from Google Cloud Console, for "Sign in with Google"
# (endpoints/account.py:google_login). Leave empty to skip the audience
# check (fine for local testing).
MT_GOOGLE_OAUTH_CLIENT_ID=

# The one account (by email) allowed to configure the shared LLM
# provider/model/key for every hosted user from the extension's popup
# Owner section, instead of you setting GOOGLE_API_KEY/etc. by hand. Must
# match the email of an account that has actually registered/signed in.
# Leave empty to disable the Owner section entirely.
MT_ADMIN_EMAIL=
